{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tapete",
	"version": "3.6.1",
	"identifier": "com.estigio.proxybuilder",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1520",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Tapete",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 640,
				"visible": false,
				"backgroundColor": "#1d1b19"
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"img-src": "'self' pbimg: http://pbimg.localhost data: blob:",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data: pbimg: http://pbimg.localhost",
				"connect-src": "ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'none'"
			},
			"devCsp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"category": "Utility",
		"shortDescription": "Prepara, prueba y juega tus decks de Magic",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": {
				"depends": [],
				"conflicts": ["proxy-builder"],
				"replaces": ["proxy-builder"],
				"provides": ["proxy-builder"]
			},
			"rpm": {
				"conflicts": ["proxy-builder"],
				"obsoletes": ["proxy-builder"]
			}
		},
		"windows": {
			"nsis": {
				"installerHooks": "./windows/hooks.nsh"
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["proxybuilder", "tapete"]
			},
			"mobile": [
				{
					"scheme": ["proxybuilder", "tapete"],
					"appLink": false
				}
			]
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QUQ1QjE0NkQ0M0Y1NDUKUldSRjlVTnRGRnV0MTZ5cFZHd3FCZ1NjaHgyRU9OZXBDVklNZkhzemo3VXpyek53dmM0dUJkanIK",
			"endpoints": [
				"https://github.com/PoolFlamingo/tapete/releases/latest/download/latest.json",
				"https://github.com/PoolFlamingo/proxy-builder/releases/latest/download/latest.json"
			],
			"requireSignedVersion": true,
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
